# --- LLM ---
# anthropic = Claude with your commercial API key (default)
# ollama    = free local open-source model (https://ollama.com; ollama pull llama3.2:3b)
# gemini    = Google Gemini API free tier (https://aistudio.google.com/apikey)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
# Server-side refusal fallbacks: default | off
CLAUDE_FALLBACKS=default
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
# Cache LLM responses on disk while iterating (saves API cost / rate limit)
LLM_CACHE=false

# --- Storage ---
# Leave S3_BUCKET empty to keep everything under ./data (no AWS needed).
S3_BUCKET=
S3_PREFIX=patient-followup
AWS_REGION=us-east-1

# --- RAG (embeddings run locally for free) ---
VECTOR_STORE=chroma        # chroma | faiss
EMBEDDINGS=default         # default (local MiniLM) | fake (tests only)
RETRIEVER_K=8
